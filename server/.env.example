PORT=5000
NODE_ENV=development
# Production: must be an https:// origin, for example https://weatherwise.example.com
CLIENT_URL=http://localhost:5173
# Public URL of this API, used to build OAuth callback URLs.
API_PUBLIC_URL=http://localhost:5000
MONGODB_URI=your_mongodb_connection_string
# Production: at least 32 characters. Use a secret manager, not a committed file.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Optional. Falls back to JWT_SECRET when empty. Use a separate 32+ char value in production.
RESET_SECRET=

# Optional OAuth. Set both values for a provider to enable it.
# Google callback: http://localhost:5000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: http://localhost:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional password reset email. Brevo free tier: smtp-relay.brevo.com:587.
# Without these values, development prints the reset link in the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional. The keyless ArcGIS geocoder is used for small localities; a key
# raises the quota and should be used for production traffic.
ARCGIS_API_KEY=
